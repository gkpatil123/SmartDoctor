# SmartDoctor Environment Configuration
# Copy this file to .env and fill in values as needed.

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# --- Database ---
DATABASE_URL=sqlite:///./smartdoctor.db

# --- Clinic Defaults ---
CLINIC_NAME=SmartDoctor Clinic
CLINIC_PHONE=+91-XXXXXXXXXX
CLINIC_TIMEZONE=Asia/Kolkata

# --- WhatsApp Mode ---
# Set to "demo" (default, no Meta credentials needed) or "meta" (requires credentials below)
WHATSAPP_MODE=demo

# --- Meta WhatsApp Cloud API (only needed when WHATSAPP_MODE=meta) ---
# Get these from https://developers.facebook.com/ -> Your App -> WhatsApp -> API Setup
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_API_VERSION=v21.0
